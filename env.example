# DiscordPHP-MTGPocket configuration. Copy to `.env` and fill in what you use:
#   cp env.example .env
# A variable already set in the environment wins over `.env`. Comments must be
# on their own line. Empty values use the default.

# Discord bot token. Required for bot.php.
TOKEN=
# debug, info, notice, warning or error. Optional; defaults to info.
LOG_LEVEL=

# Where players, inventories, decks and card pools are kept as JSON files.
# Optional; defaults to var/data.
MTGPOCKET_DATA=
# The shop's price list and match points. Optional; defaults to config/economy.php.
MTGPOCKET_ECONOMY=
# The game modes (deck rules, libraries, life). Optional; defaults to config/modes.php.
MTGPOCKET_MODES=
# Daily and weekly quests. Optional; defaults to config/quests.php.
MTGPOCKET_QUESTS=
# Booster drafts (entry fee, pod size, time limits). Optional; defaults to config/drafts.php.
MTGPOCKET_DRAFTS=

# Where MTGJSON's AllPrintings SQLite build is kept (~700 MB; ~250 MB download on
# first run). Shared with DiscordPHP-MTG. Optional; defaults to
# var/mtgjson/AllPrintings.sqlite.
MTGJSON_DATABASE=
# Set to 0 to go without card prices. Optional; on.
MTG_PRICES=
